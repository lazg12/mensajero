# ====================================================================
# .gitignore para Mensajero C++ (Windows MSVC & Debian G++)
# ====================================================================

# --- IDEs (VS Code & Visual Studio) ---
.vscode/
.vs/
*.user
*.userosscache
*.sln
*.vcxproj
*.filters

# --- Compilación y Salida ---
# Ignora ejecutables en ambos sistemas
*.exe
*.out
*.app
bin/
out/
# Archivos de objeto y depuración
*.o
*.obj
*.pdb
*.ilk
*.d
*.idb

# --- Librerías Estáticas y Dinámicas ---
*.lib
*.a
*.dll
*.so
*.so.*
*.dylib

# --- Directorios de Construcción ---
build/
Build/
build-*/
x64/
x86/
Debug/
Release/

# --- Gestores de Dependencias ---
# Como usas vcpkg para tus otros proyectos, mejor dejarlo fuera
vcpkg_installed/
.vcpkg/

# --- CMake (Si decides usarlo en el futuro) ---
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# --- Archivos Temporales y del Sistema ---
*.tmp
*.log
*.bak
*.swp
.DS_Store
Thumbs.db

# --- Documentación ---
# Ignora la carpeta de documentación generada (Doxygen) 
# para que solo subas el código fuente.
docs/html/
docs/latex/